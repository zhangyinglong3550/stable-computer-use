    return out(payload, exit_for(payload))


def cmd_remember(args) -> int:
    """把「这个目标 → 这个元素」记下来，下次零成本命中。

    典型用法：调用方的 LLM 从 decide 的 candidates 里选好之后，回填一次。
    """
    snap = snapshot(args.app)
    elements = snap.get("elements") or []
    el = next((e for e in elements if e["ref"] == args.ref), None)
    if not el:
        die("stale_ref", f"ref {args.ref} 不在当前快照里", 5)
    memory_store(args.app, args.goal, el, source="explicit")
    return out({"ok": True, "remembered": {"goal": args.goal, "ref": el["ref"],
                                           "name": el.get("label") or el.get("value"),
                                           "role": el.get("role")}})


def cmd_decide(args) -> int:
    started = time.time()
    result = decide(args.app, args.goal, min_conf=args.min_confidence,
                    no_decider=args.no_decider, max_opts=args.max)
    result["totalMs"] = int((time.time() - started) * 1000)
    if result.get("ok"):
        return out(result, 0)
    return out(result, 2)


def cmd_do(args) -> int:
    """decide + act 一次做完，省掉一次进程启动。"""
    decision = decide(args.app, args.goal, min_conf=args.min_confidence,
                      no_decider=args.no_decider, max_opts=args.max)
    if not decision.get("ok"):
        return out(decision, 2)
    if decision.get("tier") == "recipe":
        die("recipe_tier", "命中 recipe，请用 scu recipe run", 3)
    ref = decision.get("targetRef")
    if not ref:
        die("no_target", "决策没有给出目标", 6)

    op = args.op or "click"
    extra = ["--ref", ref]
    if op == "type":
        if not args.text:
            die("missing_text", "op=type 需要 --text", 4)
        extra += ["--text", args.text]
        argv = ["act", "--app", args.app, "--op", "type", "--text", args.text]
    elif op == "set":
        if not args.value:
            die("missing_value", "op=set 需要 --value", 4)
        argv = ["act", "--app", args.app, "--op", "set", "--ref", ref, "--value", args.value]
    else:
        argv = ["act", "--app", args.app, "--op", "click", "--ref", ref]

    acted = run_ax(argv)
    return out({"ok": bool(acted.get("ok")), "tier": decision.get("tier"),
                "goal": args.goal, "targetRef": ref,
                "targetName": decision.get("targetName"),
                "confidence": decision.get("confidence"),
                "acted": acted}, exit_for(acted) if isinstance(acted, dict) else 1)


def cmd_shot(args) -> int:
    """按窗口矩形截图。

    不用 ScreenCaptureKit（那需要一个 .app 上下文），直接 `screencapture -R`：
    启动快、无依赖、能在任何 CLI 里跑。代价是图像里会带上盖在窗口上的其他窗口。
    """
    snap = snapshot(args.app)
    elements = snap.get("elements") or []
    if not elements:
        die("empty_snapshot", "拿不到窗口", 3)
    rect = elements[0].get("rect")
    if not rect:
        die("no_geometry", "窗口没有几何信息，无法截图", 8)

    x, y, w, h = int(rect["x"]), int(rect["y"]), int(rect["w"]), int(rect["h"])
    out_path = os.path.abspath(args.out)
    Path(out_path).parent.mkdir(parents=True, exist_ok=True)
    argv = ["screencapture", "-x"]
    if args.no_shadow:
        argv.append("-o")
    argv += ["-R", f"{x},{y},{w},{h}", out_path]
    proc = subprocess.run(argv, capture_output=True, text=True)
    if proc.returncode != 0 or not Path(out_path).is_file():
        die("shot_failed", (proc.stderr or "screencapture 失败")[:200], 9)
    # Retina 屏上 screencapture -R 输出的是 2x 像素，而 AX 矩形是点。
    # 不告诉调用方这个比例，从截图里量出来的坐标就会差一倍。
    scale = _image_scale(out_path, w, h)
    return out({"ok": True, "path": out_path, "rect": rect, "scale": scale,
                "hint": (f"图像像素 = 屏幕点 × {scale}；点击时请用屏幕坐标点："
                         f"screen_x = {x} + img_x / {scale}, screen_y = {y} + img_y / {scale}"),
                "bytes": Path(out_path).stat().st_size,
                "note": "矩形截图会带上覆盖在窗口上的其他窗口；需要纯净窗口图请走 ScreenCaptureKit"})


def _image_scale(path: str, point_w: int, point_h: int) -> float:
    """从 PNG 头读像素尺寸，和窗口点数相除得到缩放比。"""
    try:
        with open(path, "rb") as f:
            head = f.read(33)
        if head[:8] == b"\x89PNG\r\n\x1a\n":
            import struct
            px_w, px_h = struct.unpack(">II", head[16:24])
            if point_w > 0:
                return round(px_w / point_w, 3)
    except Exception:
        pass
    return 1.0


def cmd_batch(args) -> int:
    """从 stdin 读 JSONL 命令，逐条执行并输出 JSONL。

    一个进程跑完一整串动作 —— 消掉「每条命令一次 Python 启动」的地板。
    这是 Codex 用 code-mode 的原因：一步一进程最快也就 60-70ms。
    """
    ensure_daemon()
    processed = 0
    failed = 0
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except json.JSONDecodeError:
            out({"ok": False, "reasonCode": "bad_json", "line": line[:120]}, 1)
            failed += 1
            continue
        if args.dry_run:
            out({"ok": True, "dryRun": True, "would": req}, 0)
            processed += 1
            continue
        cmd = req.pop("cmd", None)
        if cmd not in ("click", "set", "type", "snapshot", "ping"):
            out({"ok": False, "reasonCode": "unsupported_cmd", "cmd": cmd}, 4)
            failed += 1
            continue
        r = dcall({"cmd": cmd, **req}) or {"ok": False, "reasonCode": "daemon_unavailable"}
        out(r, exit_for(r))
        processed += 1
        if r.get("ok") is not True:
            failed += 1
        if args.stop_on_error and r.get("ok") is not True:
            break
    sys.stderr.write(f"# batch: {processed} 条，失败 {failed}\n")
    return 0 if failed == 0 else 1


def cmd_bench(args) -> int:
    runs = args.runs
    times = []
    for _ in range(runs):
        t0 = time.perf_counter()
        run_ax(["snapshot", "--app", args.app, "--json"])
        times.append((time.perf_counter() - t0) * 1000)
    times.sort()
    return out({"ok": True, "app": args.app, "runs": runs,
                "p50": round(times[len(times) // 2], 1),
                "p95": round(times[min(len(times) - 1, int(len(times) * 0.95))], 1),
                "min": round(times[0], 1), "max": round(times[-1], 1)})


# ---------------------------------------------------------------- 入口

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="scu", description="stable-computer-use: 精准 macOS computer-use")
    p.add_argument("--version", action="version", version=f"scu {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor").set_defaults(fn=cmd_doctor)
    sub.add_parser("apps").set_defaults(fn=cmd_apps)

    s = sub.add_parser("snapshot")
    s.add_argument("--app", required=True)
    s.add_argument("--json", action="store_true")
    s.add_argument("--max", type=int, default=4000)
    s.set_defaults(fn=cmd_snapshot)

    c = sub.add_parser("click")
    c.add_argument("--app", required=True)
    c.add_argument("--ref")
    c.add_argument("--text")
    c.add_argument("--xy", help="屏幕坐标 X,Y（配合 scs shot 使用）")
    c.add_argument("--via", default="ax", choices=["ax", "mouse"],
                   help="ax=走无障碍动作（不动鼠标、不抢焦点，默认）；mouse=合成鼠标事件")
    c.add_argument("--button", choices=["left", "right"])
    c.add_argument("--count", type=int)
    c.add_argument("--take-over", action="store_true",
                   help="明确授权接管前台（会打断用户）。仅在 --via mouse 或键盘输入时需要")
    c.add_argument("--idle-seconds", type=float, default=2.0,
                   help="接管前要求用户已空闲的秒数，默认 2 秒")
    c.set_defaults(fn=cmd_click)

    t = sub.add_parser("type")
    t.add_argument("--app", required=True)
    t.add_argument("--text", required=True)
    t.add_argument("--ref", help="目标输入框的 ref（不给则用该 app 的焦点元素）")
    t.add_argument("--take-over", action="store_true",
                   help="AX 写不进去时，授权切到前台用真键盘输入")
    t.add_argument("--idle-seconds", type=float, default=2.0)
    t.set_defaults(fn=cmd_type)

    k = sub.add_parser("key")
    k.add_argument("--app", required=True)
    k.add_argument("--key", required=True)
    k.add_argument("--via", default="ax", choices=["ax", "mouse"],
                   help="ax=先查菜单栏（后台可触发）；mouse=真键盘，需要接管前台")
    k.add_argument("--take-over", action="store_true")
    k.add_argument("--idle-seconds", type=float, default=2.0)
    k.set_defaults(fn=cmd_key)

    sc = sub.add_parser("scroll")
    sc.add_argument("--app", required=True)
    sc.add_argument("--ref", required=True)
    sc.add_argument("--direction", default="down", choices=["up", "down", "left", "right"])
    sc.add_argument("--pages", type=float, default=1.0)
    sc.add_argument("--take-over", action="store_true")
    sc.add_argument("--idle-seconds", type=float, default=2.0)
    sc.set_defaults(fn=cmd_scroll)

    st = sub.add_parser("set")
    st.add_argument("--app", required=True)
    st.add_argument("--ref", required=True)
    st.add_argument("--value", required=True)
    st.set_defaults(fn=cmd_set)

    v = sub.add_parser("verify")
    v.add_argument("--app", required=True)
    v.add_argument("--ref", required=True)
    v.set_defaults(fn=cmd_verify)

    sh = sub.add_parser("shot")
    sh.add_argument("--app", required=True)
    sh.add_argument("--out", required=True)
    sh.add_argument("--no-shadow", action="store_true")
    sh.set_defaults(fn=cmd_shot)

    rm = sub.add_parser("remember")
    rm.add_argument("--app", required=True)
    rm.add_argument("--goal", required=True)
    rm.add_argument("--ref", required=True)
    rm.set_defaults(fn=cmd_remember)

    d = sub.add_parser("decide")
    d.add_argument("--app", required=True)
    d.add_argument("--goal", required=True)
    d.add_argument("--max", type=int, default=8)
    d.add_argument("--min-confidence", type=float, default=CONFIDENCE_HIGH)
    d.add_argument("--no-decider", action="store_true")
    d.set_defaults(fn=cmd_decide)

    do = sub.add_parser("do")
    do.add_argument("--app", required=True)
    do.add_argument("--goal", required=True)
    do.add_argument("--op", default="click", choices=["click", "type", "set"])
    do.add_argument("--text")
    do.add_argument("--value")
    do.add_argument("--max", type=int, default=8)
    do.add_argument("--min-confidence", type=float, default=CONFIDENCE_HIGH)
    do.add_argument("--no-decider", action="store_true")
    do.set_defaults(fn=cmd_do)

    r = sub.add_parser("recipe")
    r.add_argument("action", choices=["save", "list", "run"])
    r.add_argument("name", nargs="?")
    r.add_argument("--app")
    r.add_argument("--goal", default="")
    r.set_defaults(fn=cmd_recipe)

    bt = sub.add_parser("batch", help="从 stdin 读 JSONL 命令，一个进程跑完")
    bt.add_argument("--stop-on-error", action="store_true")
    bt.add_argument("--dry-run", action="store_true")
    bt.set_defaults(fn=cmd_batch)

    b = sub.add_parser("bench")
    b.add_argument("--app", required=True)
    b.add_argument("--runs", type=int, default=10)
    b.set_defaults(fn=cmd_bench)

    return p


def main() -> int:
    args = build_parser().parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
