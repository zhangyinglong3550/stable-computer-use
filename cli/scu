def _lean(el: dict) -> dict:
    keep = ("ref", "target_ref", "role", "label", "value", "actions", "enabled", "rect", "score")
    return {k: el[k] for k in keep if el.get(k) not in (None, "", [], {})}


def cmd_doctor(args) -> int:
    try:
        binary = find_ax_binary()
    except SystemExit:
        return 2
    health = run_ax(["doctor"])
    healthy = bool(health.get("ok"))
    payload = {
        "ok": healthy,
        "version": VERSION,
        "axBinary": str(binary),
        "accessibility": health.get("accessibility"),
        "accessibilityUsable": health.get("accessibilityUsable"),
        "axProbeCode": health.get("axProbeCode"),
        "screenRecording": health.get("screen_recording"),
        "macos": health.get("macos"),
        "decider": "jev" if os.environ.get("TYPESAFE_API_KEY") else "off",
    }
    payload["windowUsable"] = health.get("windowUsable")
    if not healthy:
        payload["reasonCode"] = health.get("reasonCode") or "permission_missing"
        payload["hint"] = health.get("hint") or (
            "到 系统设置 → 隐私与安全性 → 辅助功能，勾选你的终端，然后重试")
    code = {"ax_cannot_complete": 10, "no_accessible_windows": 3}.get(
        health.get("reasonCode"), 3)
    return out(payload, 0 if healthy else code)


def cmd_apps(args) -> int:
