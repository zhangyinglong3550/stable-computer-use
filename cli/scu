#!/usr/bin/env python3
"""scu — stable-computer-use: 给任意 Agent 的 macOS 精准 computer-use CLI。

设计要点
- 单文件、纯标准库、无构建步骤（Swift 助手用 swift build 出，本文件只管调用）
- 四级快路径：exact(0ms) → recipe(~50ms) → lexical(<1ms) → JEV(~2s) → 交回调用方
- 每一级都如实报告自己在哪一级、置信度多少
- 统一 reasonCode + exit code，调用方只写一条降级分支

命令
  scu doctor
  scu apps
  scu snapshot --app APP [--json] [--max N]
  scu click --app APP (--ref R | --text T | --xy X,Y) [--via auto|ax|mouse]
  scu type  --app APP --text T [--ref R]
  scu key   --app APP --key "super+s"
  scu scroll --app APP --ref R --direction down [--pages N]
  scu set   --app APP --ref R --value V
  scu verify --app APP --ref R
  scu do    --app APP --goal "..."
  scu decide --app APP --goal "..." [--no-decider] [--min-confidence X]
  scu recipe save NAME < steps.json
  scu recipe run  NAME --app APP
  scu bench --app APP [--runs N]
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

VERSION = "0.1.0"

# ---------------------------------------------------------------- 运行时定位

HOME = Path.home()
STATE_DIR = Path(os.getenv("SCU_STATE", str(HOME / ".stable-computer-use")))
RECIPE_DIR = STATE_DIR / "recipes"
DECIDER_STATE_PATH = STATE_DIR / "decider-state.json"
MEMORY_PATH = STATE_DIR / "memory.jsonl"


def find_ax_binary() -> Path:
    """按优先级找 scu-ax：环境变量 → 仓库内构建产物 → PATH。"""
    env = os.getenv("SCU_AX")
    if env:
        p = Path(env).expanduser()
        if p.is_file():
            return p
        die("ax_binary_missing", f"SCU_AX 指向的文件不存在：{p}", 2)

    here = Path(__file__).resolve().parent
    for rel in ("runtime/.build/release/scu-ax", "runtime/.build/debug/scu-ax"):
        p = here.parent / rel
        if p.is_file():
            return p

    from shutil import which

    found = which("scu-ax")
    if found:
        return Path(found)
    die(
        "ax_binary_missing",
        "找不到 scu-ax。先在 runtime/ 下执行 `swift build -c release`，"
        "或设置 SCU_AX 指向可执行文件。",
        2,
    )


# ---------------------------------------------------------------- 输出约定

def out(payload: dict, code: int = 0) -> int:
    payload.setdefault("version", VERSION)
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    return code


def die(reason: str, detail: str, code: int = 1) -> None:
    out({"ok": False, "reasonCode": reason, "detail": detail}, code)
    raise SystemExit(code)


# ---------------------------------------------------------------- daemon
#
# 为什么需要 daemon：每次动作都 spawn 进程 + 重走整棵 AX 树，大 app 一次 800ms。
# daemon 里保留活的 AXUIElement，动作直接从缓存走，实测 0.16ms。
#
# 设计上 daemon 只是加速器：连不上就退回「spawn 一次性进程」的老路，
# 功能不受影响，只是慢。

import socket as _socket

SOCK_PATH = os.getenv("SCU_SOCK", f"/tmp/scu-{os.getuid()}.sock")
_daemon_warned = False


def _sock_call(req: dict, timeout: float = 30.0) -> dict | None:
    try:
        s = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK_PATH)
        s.sendall((json.dumps(req) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            buf += chunk
        s.close()
        return json.loads(buf.decode() or "{}")
    except Exception:
        return None


def _daemon_alive() -> bool:
    return _sock_call({"cmd": "ping"}, timeout=2.0) is not None


def ensure_daemon() -> bool:
    """确保 daemon 在跑。起不来就返回 False，调用方退回老路。"""
    global _daemon_warned
    if _daemon_alive():
        return True
    try:
        binary = find_ax_binary()
        log = open(os.devnull, "wb")
        subprocess.Popen(
            [str(binary), "serve", "--socket", SOCK_PATH],
            stdout=subprocess.DEVNULL, stderr=log, stdin=subprocess.DEVNULL,
            start_new_session=True, close_fds=True,
        )
    except Exception:
        if not _daemon_warned:
            _daemon_warned = True
        return False
    for _ in range(40):          # 最多等 2 秒
        time.sleep(0.05)
        if _daemon_alive():
            return True
    return False


def dcall(req: dict, timeout: float = 30.0) -> dict | None:
    """优先走 daemon；不可用则返回 None 让调用方退化。"""
    r = _sock_call(req, timeout)
    if r is not None:
        return r
    if ensure_daemon():
        return _sock_call(req, timeout)
    return None


# ---------------------------------------------------------------- 调 Swift 助手

def run_ax(argv: list[str], timeout: float = 30.0) -> dict:
    binary = find_ax_binary()
    started = time.time()
    try:
        proc = subprocess.run(
            [str(binary)] + argv,
            capture_output=True, text=True, timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        die("ax_timeout", f"scu-ax {' '.join(argv)} 超时 {timeout}s", 9)
    elapsed = int((time.time() - started) * 1000)

    raw = (proc.stdout or "").strip()
    if not raw:
        detail = (proc.stderr or "").strip()[:300] or "scu-ax 无输出"
        # Swift 侧用 exit code 表达可恢复错误，这里透传
        die(_reason_from_exit(proc.returncode), detail, proc.returncode or 1)
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        die("ax_bad_json", raw[:300], 1)
    payload.setdefault("elapsedMs", elapsed)
    return payload


def _reason_from_exit(code: int) -> str:
    return {
        2: "app_not_found",
        3: "no_window",
        4: "bad_args",
        5: "stale_ref",
        6: "text_not_found",
        7: "disabled",
        8: "no_geometry",
        9: "ax_timeout",
        10: "ax_cannot_complete",
    }.get(code, "ax_failed")


# ---------------------------------------------------------------- 文本清洗与打分

_ZW = re.compile(r"[\u200b-\u200f\u2060\ufeff\u00ad\ufe00-\ufe0f]")

INTERACTIVE_ROLES = {
    "AXButton", "AXTextField", "AXTextArea", "AXCheckBox", "AXRadioButton",
    "AXPopUpButton", "AXMenuItem", "AXMenuBarItem", "AXLink", "AXTab",
    "AXComboBox", "AXSlider", "AXIncrementor", "AXToolbarButton",
    "AXDisclosureTriangle", "AXSearchField",
}
CONTAINER_ROLES = {"AXWindow", "AXGroup", "AXScrollArea", "AXOutline", "AXTable", "AXRow", "AXCell"}


def clean(text: str | None) -> str:
    if not text:
        return ""
    return re.sub(r"\s+", " ", _ZW.sub("", unicodedata.normalize("NFKC", text))).strip().lower()


def _grams(text: str) -> set[str]:
    t = re.sub(r"[\s\W_]+", "", text)
    if not t:
        return set()
    return {t} if len(t) == 1 else {t[i:i + 2] for i in range(len(t) - 1)}


def _dice(a: set[str], b: set[str]) -> float:
    if not a or not b:
        return 0.0
    return 2 * len(a & b) / (len(a) + len(b))


def _role_prior(role: str, has_action: bool) -> float:
    if has_action:
        base = 1.0
    elif role in INTERACTIVE_ROLES:
        base = 0.85
    elif role in CONTAINER_ROLES:
        base = 0.45
    else:
        base = 0.4
    return 0.35 if role == "AXStaticText" else base


def score_element(goal: str, el: dict) -> float:
    q = clean(goal)
    label = clean(el.get("label"))
    value = clean(el.get("value"))

    contain = 0.0
    if q and label and (q in label or label in q):
        contain = 1.0 if q == label else 0.9
    elif q and value and (q in value or value in q):
        contain = 0.6

    text_s = max(_dice(_grams(q), _grams(label)),
                 _dice(_grams(q), _grams(value)) * 0.75,
                 contain)
    total = text_s * _role_prior(el.get("role", ""), bool(el.get("actions")))
    return total * (1.0 + min(el.get("depth", 0), 12) * 0.004)


def useful_target(el: dict) -> bool:
    """值得作为兜底候选的：有文字，或者是可交互角色/有动作的控件。"""
    has_text = bool(el.get("label") or el.get("value"))
    return has_text or bool(el.get("actions")) or el.get("role") in INTERACTIVE_ROLES


def rank(goal: str, elements: list[dict], top_k: int = 8) -> list[dict]:
    """闭集排序。永不返空 —— 词法弱时用可点击性兜底，绝不丢弃候选。"""
    def key(e: dict) -> tuple:
        # 分数 > 有文字 > 可点 > 浅层：没文字的空容器永远排最后
        has_text = bool(e.get("label") or e.get("value"))
        return (e["score"], has_text, bool(e.get("actions")), -e.get("depth", 0))

    scored = [{**el, "score": round(score_element(goal, el), 4)} for el in elements]
    scored.sort(key=key, reverse=True)
    strong = [e for e in scored if e["score"] >= 0.05]
    if len(strong) < top_k:
        seen = {e["ref"] for e in strong}
        backfill = [e for e in scored
                    if e["ref"] not in seen and useful_target(e)][:top_k - len(strong)]
        strong += backfill
        strong.sort(key=key, reverse=True)
    return strong[:top_k]


CONFIDENCE_HIGH = 0.9
CONFIDENCE_MEDIUM = 0.5


def confidence_of(ranked: list[dict]) -> tuple[float, str]:
    if not ranked:
        return 0.0, "low"
    top = ranked[0]["score"]
    second = ranked[1]["score"] if len(ranked) > 1 else 0.0
    margin = (top - second) / top if top else 0.0
    conf = max(0.0, min(1.0, top * (0.55 + 0.45 * margin)))
    gate = "high" if conf >= CONFIDENCE_HIGH else ("medium" if conf >= CONFIDENCE_MEDIUM else "low")
    return round(conf, 3), gate


def describe(el: dict) -> str:
    role = el.get("role", "").replace("AX", "")
    name = el.get("label") or el.get("value") or ""
    extra = ""
    if el.get("value") and el.get("label"):
        extra = f" (当前值: {el['value']})"
    return f"{role}: {name}{extra}".strip()


# ---------------------------------------------------------------- snapshot

def snapshot(app: str, max_n: int = 4000) -> dict:
    snap = dcall({"cmd": "snapshot", "app": app, "max": max_n})
    if snap is None:
        snap = run_ax(["snapshot", "--app", app, "--json", "--max", str(max_n)])
    elements = snap.get("elements") or []
    # 文字节点的目标是最近的可点祖先 —— 直接换成祖先 ref，调用方不用关心
    for el in elements:
        if el.get("actionable_ref"):
            el["target_ref"] = el["actionable_ref"]
        else:
            el["target_ref"] = el["ref"]
    snap["elements"] = elements
    return snap


# ---------------------------------------------------------------- JEV

TYPESAFE_URL = os.getenv("TYPESAFE_URL", "https://api.typesafe.ai/v1/systemone")
TYPESAFE_MODEL = os.getenv("TYPESAFE_MODEL", "jev-latest")
DECIDER_OK_TTL = 600
DECIDER_FAIL_TTL = 300


def _load_decider_state() -> dict:
    try:
        return json.loads(DECIDER_STATE_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {}


def _save_decider_state(state: dict) -> None:
    try:
        DECIDER_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        DECIDER_STATE_PATH.write_text(json.dumps(state), encoding="utf-8")
    except Exception:
        pass


def typesafe_ask(state: dict, questions: dict, timeout: float = 30.0) -> dict:
    body = json.dumps({"state": state, "model": TYPESAFE_MODEL, "questions": questions}).encode()
    req = urllib.request.Request(
        TYPESAFE_URL, data=body, method="POST",
        headers={"Authorization": f"Bearer {os.environ['TYPESAFE_API_KEY']}",
                 "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode() or "{}")


def classify_decider_error(exc: Exception) -> str:
    if isinstance(exc, urllib.error.HTTPError):
        return {401: "invalid_key", 403: "invalid_key", 402: "quota_exhausted",
                404: "endpoint_not_found", 429: "rate_limited"}.get(exc.code, f"http_{exc.code}")
    if isinstance(exc, urllib.error.URLError):
        return "unreachable"
    if isinstance(exc, TimeoutError):
        return "timeout"
    return f"error_{type(exc).__name__}"


def probe_decider(force: bool = False) -> dict:
    if not os.environ.get("TYPESAFE_API_KEY"):
        return {"available": False, "reasonCode": "key_missing", "detail": "TYPESAFE_API_KEY 未设置"}
    now = time.time()
    if not force:
        cached = _load_decider_state()
        age = now - float(cached.get("at") or 0)
        ttl = DECIDER_OK_TTL if cached.get("available") else DECIDER_FAIL_TTL
        if cached and age < ttl:
            return {**cached, "cached": True}
    try:
        typesafe_ask({"probe": "health check"},
                     {"ok": {"type": "noul", "instructions": "Is this a health check?"}},
                     timeout=8.0)
        verdict = {"available": True, "reasonCode": "ok", "detail": "探测通过"}
    except Exception as e:
        verdict = {"available": False, "reasonCode": classify_decider_error(e),
                   "detail": f"{type(e).__name__}: {e}"[:200]}
    _save_decider_state({**verdict, "at": now})
    return verdict


# ---------------------------------------------------------------- 决策记忆

def _mem_key(app: str, goal: str) -> str:
    return hashlib.sha1(f"{app}||{clean(goal)}".encode()).hexdigest()[:16]


def memory_lookup(app: str, goal: str, elements: list[dict]) -> dict | None:
    """查记忆，并**在当前快照里验证**目标还在。ref 稳定，所以通常直接命中。

    记忆存的是 ref + 名字 + 角色：ref 命中就用；ref 失效则按名字+角色重新定位。
    """
    if not MEMORY_PATH.is_file():
        return None
    key = _mem_key(app, goal)
    entry = None
    try:
        for line in MEMORY_PATH.read_text(encoding="utf-8").splitlines():
            if not line.strip():
                continue
            rec = json.loads(line)
            if rec.get("key") == key:
                entry = rec          # 后写的覆盖先写的
    except Exception:
        return None
    if not entry:
        return None

    by_ref = {e["ref"]: e for e in elements}
    live = by_ref.get(entry.get("ref"))
    if live and (live.get("label") or live.get("value")):
        return {**entry, "hit": "ref", "element": live}

    want_label = clean(entry.get("label"))
    want_role = entry.get("role")
    for e in elements:
        if clean(e.get("label")) == want_label and (not want_role or e.get("role") == want_role):
            return {**entry, "hit": "label", "element": e}
    return None


def memory_store(app: str, goal: str, element: dict, source: str) -> None:
    rec = {
        "key": _mem_key(app, goal), "app": app, "goal": goal,
        "ref": element.get("ref"), "label": element.get("label") or element.get("value"),
        "role": element.get("role"), "source": source, "at": int(time.time()),
    }
    try:
        MEMORY_PATH.parent.mkdir(parents=True, exist_ok=True)
        with MEMORY_PATH.open("a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except Exception:
        pass


# ---------------------------------------------------------------- decide 四级阶梯

def decide(app: str, goal: str, min_conf: float = CONFIDENCE_HIGH,
           no_decider: bool = False, max_opts: int = 8) -> dict:
    snap = snapshot(app)
    elements = snap.get("elements") or []
    if not elements:
        return {"ok": False, "reasonCode": "empty_snapshot", "app": app}

    # ---- L0 精确解析：目标里直接点名的元素 ----
    exact = _exact_match(goal, elements)
    if exact:
        return {
            "ok": True, "tier": "exact", "latencyMs": 0,
            "goal": goal, "app": app,
            "targetRef": exact["target_ref"], "targetName": exact.get("label") or exact.get("value"),
            "targetRole": exact.get("role"),
            "confidence": 1.0, "confidenceGate": "high", "recommendedAction": "act",
        }

    # ---- L1 记忆：同一个目标第二次来，零成本 ----
    remembered = memory_lookup(app, goal, elements)
    if remembered:
        el = remembered["element"]
        return {
            "ok": True, "tier": "memory", "latencyMs": 0,
            "goal": goal, "app": app,
            "targetRef": el.get("target_ref", el["ref"]),
            "targetName": el.get("label") or el.get("value"),
            "targetRole": el.get("role"),
            "memoryHit": remembered["hit"], "memorySource": remembered.get("source"),
            "confidence": 0.99, "confidenceGate": "high", "recommendedAction": "act",
        }

    # ---- L2 recipe：录过就直接回放 ----
    recipe = _find_recipe(app, goal)
    if recipe:
        return {
            "ok": True, "tier": "recipe", "latencyMs": 0,
            "goal": goal, "app": app,
            "recipe": recipe["name"], "steps": recipe["steps"],
            "confidence": 1.0, "confidenceGate": "high", "recommendedAction": "replay",
        }

    # ---- L2 本地打分 ----
    ranked = rank(goal, elements, top_k=max_opts)
    conf, gate = confidence_of(ranked)
    best = ranked[0] if ranked else None
    lexical = {
        "tier": "lexical", "goal": goal, "app": app,
        "targetRef": best.get("target_ref") if best else None,
        "targetName": (best.get("label") or best.get("value")) if best else None,
        "targetRole": best.get("role") if best else None,
        "confidence": conf, "confidenceGate": gate,
        "candidates": [_lean(e) for e in ranked],
    }
    if conf >= min_conf:
        return {"ok": True, "recommendedAction": "act", "latencyMs": 0, **lexical}

    # ---- L3 JEV：在本地说不准时才付这个成本 ----
    if not no_decider:
        health = probe_decider()
        if health["available"]:
            started = time.time()
            try:
                raw = typesafe_ask(
                    {"goal": goal,
                     "window": {"app": snap.get("app"), "title": snap.get("window")}},
                    {
                        "target": {
                            "type": "choice",
                            "criteria": {e["ref"]: describe(e) for e in ranked},
                            "instructions": (
                                f"目标是：{goal}\n\n"
                                "应该操作下面哪一个界面元素？只选最能直接推进目标的那个。"
                                "如果目标元素不在选项里，仍选出最接近的一个。"
                            ),
                        }
                    },
                )
                latency = int((time.time() - started) * 1000)
                answer = (raw.get("answers") or {}).get("target") or {}
                choice = answer.get("choice")
                chosen = next((e for e in ranked if e["ref"] == choice), None)
                if chosen:
                    memory_store(app, goal, chosen, source="jev")
                    jconf = answer.get("confidence")
                    jconf = float(jconf) if isinstance(jconf, (int, float)) else 0.5
                    return {
                        "ok": True, "tier": "jev", "latencyMs": latency,
                        "goal": goal, "app": app,
                        "targetRef": chosen.get("target_ref"),
                        "targetName": chosen.get("label") or chosen.get("value"),
                        "targetRole": chosen.get("role"),
                        "confidence": round(jconf, 3),
                        "confidenceGate": "high" if jconf >= CONFIDENCE_HIGH else (
                            "medium" if jconf >= CONFIDENCE_MEDIUM else "low"),
                        "recommendedAction": "act" if jconf >= CONFIDENCE_HIGH else "recheck",
                        "probabilities": answer.get("probabilities"),
                        "candidates": [_lean(e) for e in ranked],
                    }
            except Exception as e:
                code = classify_decider_error(e)
                _save_decider_state({"available": False, "reasonCode": code,
                                     "detail": str(e)[:200], "at": time.time()})
                return _handoff(lexical, code, f"JEV 失败（{code}）")
        return _handoff(lexical, health["reasonCode"], f"JEV 不可用（{health['reasonCode']}）")

    # ---- L4 交回调用方 ----
    return _handoff(lexical, "decider_disabled", "已跳过决策器")


def _handoff(lexical: dict, reason: str, detail: str) -> dict:
    """低置信时也要交出**最佳猜测**，只是标记 ok=false。

    调用方可以：(a) 直接把 bestGuess 当候选让 LLM 复核；(b) 忽略它自己从
    candidates 里选。永远不要只丢一句"失败了"，那样调用方还得重跑一次。
    """
    return {
        "ok": False, "tier": "handoff", "reasonCode": reason, "detail": detail,
        "goal": lexical["goal"], "app": lexical["app"],
        "confidence": lexical["confidence"], "confidenceGate": lexical["confidenceGate"],
        "recommendedAction": "escalate",
        "targetRef": lexical.get("targetRef"),
        "targetName": lexical.get("targetName"),
        "targetRole": lexical.get("targetRole"),
        "bestGuess": {
            "ref": lexical.get("targetRef"),
            "name": lexical.get("targetName"),
            "confidence": lexical.get("confidence"),
        },
        "hint": "用你自己的 LLM 在 candidates 里复核 bestGuess，或另选，然后 scu click --app A --ref R",
        "candidates": lexical["candidates"],
    }


def _exact_match(goal: str, elements: list[dict]) -> dict | None:
    """L0：目标里点名了某个元素，且名字足够独特 —— 零成本直出。

    只接受「引号包裹」或「完整出现在目标里且全表唯一」的标签，宁漏不错。
    """
    quoted = re.findall(r"[\"'“”‘’「」『』]([^\"'“”‘’「」『』]{1,40})[\"'“”‘’「」『』]", goal)
    probes = [clean(q) for q in quoted] + [clean(goal)]

    for probe in probes:
        if not probe:
            continue
        hits = [e for e in elements
                if clean(e.get("label")) == probe or clean(e.get("value")) == probe]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            actionable = [h for h in hits if h.get("actions") or h.get("role") in INTERACTIVE_ROLES]
            if len(actionable) == 1:
                return actionable[0]
    return None


# ---------------------------------------------------------------- recipe

def _recipe_path(name: str) -> Path:
    return RECIPE_DIR / f"{name}.json"


def _find_recipe(app: str, goal: str) -> dict | None:
    if not RECIPE_DIR.is_dir():
        return None
    want = clean(goal)
    for p in RECIPE_DIR.glob("*.json"):
        try:
            r = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        if clean(r.get("goal", "")) == want and r.get("app") in (app, None):
            return r
    return None


def cmd_recipe(args) -> int:
    if args.action == "save":
        steps = json.load(sys.stdin)
        if not isinstance(steps, list) or not steps:
            die("bad_recipe", "stdin 必须是步骤数组，例如 [{\"op\":\"click\",\"ref\":\"abc123\"}]", 4)
        RECIPE_DIR.mkdir(parents=True, exist_ok=True)
        payload = {"name": args.name, "app": args.app, "goal": args.goal, "steps": steps}
        _recipe_path(args.name).write_text(json.dumps(payload, ensure_ascii=False, indent=2),
                                           encoding="utf-8")
        return out({"ok": True, "saved": str(_recipe_path(args.name)), "steps": len(steps)})

    if args.action == "list":
        items = []
        if RECIPE_DIR.is_dir():
            for p in sorted(RECIPE_DIR.glob("*.json")):
                try:
                    r = json.loads(p.read_text(encoding="utf-8"))
                    items.append({"name": r.get("name"), "app": r.get("app"),
                                  "goal": r.get("goal"), "steps": len(r.get("steps") or [])})
                except Exception:
                    continue
        return out({"ok": True, "recipes": items, "count": len(items)})

    if args.action == "run":
        p = _recipe_path(args.name)
        if not p.is_file():
            die("recipe_not_found", f"没有 recipe：{args.name}", 2)
        recipe = json.loads(p.read_text(encoding="utf-8"))
        app = args.app or recipe.get("app")
        if not app:
            die("missing_app", "recipe 里没记 app，请用 --app 指定", 4)
        results = []
        for i, step in enumerate(recipe.get("steps") or []):
            op = step.get("op")
            argv = ["act", "--app", app, "--op", op]
            for k in ("ref", "text", "key", "value", "direction", "pages", "via", "button", "count"):
                if step.get(k) is not None:
                    argv += [f"--{k}", str(step[k])]
            r = run_ax(argv)
            results.append({"step": i, "op": op, **r})
            if not r.get("ok"):
                return out({"ok": False, "reasonCode": "step_failed", "failedAt": i,
                            "results": results}, 7)
        return out({"ok": True, "recipe": args.name, "steps": len(results), "results": results})

    die("bad_args", "recipe 只支持 save / list / run", 4)


