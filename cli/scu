def cmd_snapshot(args) -> int:
    snap = snapshot(args.app, max_n=args.max)
    if args.json:
        return out(snap)
    print(f"APP {snap.get('app')} [{snap.get('bundle')}]  WINDOW: {snap.get('window')}")
    for el in snap.get("elements") or []:
        pad = "  " * min(el.get("depth", 0), 12)
