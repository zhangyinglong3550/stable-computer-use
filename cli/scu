EXIT_CODES = {
    "stale_ref": 5, "text_not_found": 6, "disabled": 7, "no_geometry": 8,
    "app_not_found": 2, "no_window": 3, "ax_timeout": 9, "ax_cannot_complete": 10,
    "no_accessible_windows": 3, "needs_takeover": 11, "user_active": 12,
    "no_element_at_point": 13, "no_ax_action_at_point": 13, "no_ax_action": 13,
    "ax_action_failed": 14, "recipe_not_found": 2, "cache_miss": 5,
}


def exit_for(payload: dict) -> int:
    """把失败原因翻成 exit code —— 调用方只写一条分支就能分流。"""
    if payload.get("ok"):
        return 0
    return EXIT_CODES.get(payload.get("reasonCode", ""), 1)


def _act(args, op: str, extra: list[str]) -> int:
    # 把命令行参数翻译成 daemon 请求；能用就走缓存（快 2000 倍）
    req: dict = {"cmd": op, "app": args.app}
    flat = {}
    i = 0
    while i < len(extra):
        if extra[i].startswith("--"):
            k = extra[i][2:]
            v = extra[i + 1] if i + 1 < len(extra) and not extra[i + 1].startswith("--") else True
            flat[k] = v
            i += 2 if v is not True else 1
        else:
            i += 1
    if "ref" in flat:
        req["ref"] = flat["ref"]
    if "text" in flat:
        req["text"] = flat["text"]
    if "value" in flat:
        req["value"] = flat["value"]
    if "x" in flat and "y" in flat:
        req["x"], req["y"] = float(flat["x"]), float(flat["y"])

    fast_only = op in ("click", "set", "type") and not flat.get("via") == "mouse" \
        and not flat.get("take-over")
    if fast_only:
        fast = dcall(req)
        if fast is not None:
            fast["via"] = fast.get("via", "daemon")
            return out(fast, exit_for(fast))

    argv = ["act", "--app", args.app, "--op", op] + extra
    payload = run_ax(argv)
    return out(payload, exit_for(payload))


def cmd_click(args) -> int:
    extra: list[str] = []
    if args.xy:
        try:
            x, y = [float(v) for v in args.xy.split(",")]
        except ValueError:
            die("bad_args", "--xy 格式应为 X,Y（屏幕坐标点）", 4)
        extra += ["--x", str(x), "--y", str(y)]
    elif args.ref:
        extra += ["--ref", args.ref]
    elif args.text:
        extra += ["--text", args.text]
    else:
        die("bad_args", "click 需要 --ref / --text / --xy 三者之一", 4)
    for k, v in (("via", args.via), ("button", args.button), ("count", args.count)):
        if v:
            extra += [f"--{k}", str(v)]
    if args.take_over:
        extra += ["--take-over", "--idle-seconds", str(args.idle_seconds)]
    return _act(args, "click", extra)


def cmd_type(args) -> int:
    extra = ["--text", args.text]
    if args.ref:
        extra += ["--ref", args.ref]
    if args.take_over:
        extra += ["--take-over", "--idle-seconds", str(args.idle_seconds)]
    return _act(args, "type", extra)


def cmd_key(args) -> int:
    extra = ["--key", args.key, "--via", args.via]
